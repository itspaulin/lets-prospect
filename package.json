{
  "name": "lets-prospect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "cli": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "api": "node --env-file-if-exists=.env --import tsx src/api/main.ts",
    "web": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "app": "npm run web:build && npm run api",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "node --import tsx --test 'src/**/*.test.ts' 'worker/**/*.test.ts'",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "csv-parse": "^6.1.0",
    "fastify": "5.12.7",
    "nodemailer": "^10.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "6.1.2",
    "smtp-server": "^3.21.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  }
}
