# Banco SQLite local (fora do git).
DATABASE_PATH=./data/prospeccao.db
SCORING_CONFIG_PATH=./config/scoring.json
SENDING_CONFIG_PATH=./config/sending.json

# Remetente: aparece no From e no rodapé de toda mensagem (CAN-SPAM exige endereço postal).
SENDER_NAME=
SENDER_EMAIL=
SENDER_POSTAL_ADDRESS=

# outbox = simulado: grava .eml em OUTBOX_DIR e não envia nada. smtp = envio real.
EMAIL_TRANSPORT=outbox
OUTBOX_DIR=./data/outbox

# Só com EMAIL_TRANSPORT=smtp. Use senha de app, nunca a senha principal da conta.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_MS=30000

# Prospecção automática (hunter.io). Sem a chave, os comandos `prospect` avisam que falta configurar.
HUNTER_API_KEY=

# Leads por telefone (Google Places API (New)). Crie a chave no Google Cloud, ative a Places API (New) e o faturamento.
# Sem a chave, os comandos `lead` avisam que falta configurar.
GOOGLE_PLACES_API_KEY=

# Qualificação por IA (Amazon Bedrock). Crie uma API key no console do Bedrock (menu API keys).
# O modelo precisa estar liberado na conta (formulário de uso da Anthropic).
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
